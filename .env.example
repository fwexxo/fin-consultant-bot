# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Числовой Telegram ID владельца. Бот отвечает только ему.
# Узнать: написать боту /start при пустом значении — он вернёт твой ID.
OWNER_ID=

# Базовая валюта для сводных отчётов
BASE_CURRENCY=BYN

# Путь к файлу базы
DATABASE_PATH=./data/finance.db

# Часовой пояс для напоминаний
TZ=Europe/Minsk

# Час ежедневной проверки платежей (0-23)
REMINDER_HOUR=10

# Авторизация Claude по подписке: токен из `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Распознавание голосовых. Обе переменные обязательны — без них
# бот попросит написать текстом, но работать не перестанет.
# Модель base: ~5 сек на сообщение, пик памяти 285 МБ.
# Модель small: точнее на редких словах, но ~22 сек и 747 МБ.
WHISPER_BIN=/usr/local/bin/whisper-cli
WHISPER_MODEL=/opt/whisper.cpp/models/ggml-base.bin
WHISPER_LANG=ru
WHISPER_THREADS=1

# Автоприём СМС от банка (номер 900).
# Наблюдатель на маке читает базу Messages и передаёт новые СМС сюда по SSH.
SMS_CARD=MIR-1234
SMS_CARD_ACCOUNT=Карта RUB
SMS_CASH_ACCOUNT=Наличные RUB
# Операции строго с этой даты. Более ранние игнорируются.
SMS_SINCE=2026-08-22
