<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Шаблон задания launchd. Все значения в двойных подчёркиваниях
  подставляет mac/install.sh из переменных окружения — личных данных
  в этом файле нет и быть не должно.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.finbot.sms</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__APP__/dist/mac/watch-sms.js</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>SMS_SINCE</key>
    <string>__SMS_SINCE__</string>
    <key>SMS_SENDER</key>
    <string>__SMS_SENDER__</string>
    <key>SMS_CARD_PREFIX</key>
    <string>__SMS_CARD_PREFIX__</string>
    <key>SSH_TARGET</key>
    <string>__SSH_TARGET__</string>
    <key>REMOTE_APP</key>
    <string>__REMOTE_APP__</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Раз в 5 минут: чаще нет смысла, банк и так шлёт с задержкой. -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__LOGDIR__/sms-watch.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGDIR__/sms-watch.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
