# Локальные настройки наблюдателя за СМС.
# Скопируй в mac/watcher.env и заполни своими значениями.
# watcher.env в .gitignore: там адрес твоего сервера и номер карты.

# Куда ходить по SSH (должен работать вход без пароля, по ключу)
SSH_TARGET=root@203.0.113.10

# Начало текста СМС, по которому отбираются нужные сообщения.
# Посмотри своё сообщение от банка и скопируй начало строки.
SMS_CARD_PREFIX=Счёт карты MIR-1234

# Операции строго с этой даты. Более ранние игнорируются —
# так прошлые траты не хлынут в бота при первом запуске.
SMS_SINCE=2026-01-01

# Номер отправителя СМС (для Сбербанка — 900)
SMS_SENDER=900

# Куда развёрнут бот на сервере
REMOTE_APP=/opt/fin-bot
