[Unit]
Description=Финансовый консультант — телеграм-бот
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=finbot
Group=finbot
WorkingDirectory=/opt/fin-bot
EnvironmentFile=/opt/fin-bot/.env

# Claude Agent SDK запускает `claude` CLI подпроцессом, а тот пишет
# состояние в $HOME. Без явного HOME он ушёл бы в /root.
Environment=HOME=/opt/fin-bot
Environment=NODE_ENV=production

ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5

# Жёсткий потолок памяти. Посчитан по замерам: сам бот ~50 МБ,
# whisper на модели base даёт пик 285 МБ, подпроцесс claude ещё ~300 МБ.
# Прежних 700 МБ на такую связку уже не хватало.
MemoryMax=1100M
MemoryHigh=950M

# Права по минимуму: боту нужен только собственный каталог.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fin-bot

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
